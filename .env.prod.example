# Copy to .env.prod (mode 600, gitignored) and fill in real values.
# Used by scripts/deploy-blue-green.sh (the only production deploy path).
# NEVER commit the filled-in copy.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=metamcp_db

# Tenant mode (SaaS). TENANT_BASE_HOST enables it; the deploy default is
# mcp.subimpact.net. TENANT_SECRET_KEY is then required at boot.
TENANT_BASE_HOST=mcp.subimpact.net
TRIAL_DAILY_LIMIT=1000

# Generate real values with:
#   TENANT_API_SERVICE_TOKEN: openssl rand -hex 32   (must match the SaaS .env)
#   TENANT_SECRET_KEY:        openssl rand -base64 32 (back this up: lost key = lost credentials)
TENANT_API_SERVICE_TOKEN=replace-with-openssl-rand-hex-32
TENANT_SECRET_KEY=replace-with-openssl-rand-base64-32

# Optional limits (defaults shown). Tenant upstream connections share a budget
# of TENANT_POOL_BUDGET (30% of the pool), and each tenant may have
# TENANT_NS_IN_FLIGHT connections in use (3, its share of the budget).
# TENANT_MAX_SERVERS=10
# TENANT_TEST_PER_MINUTE=10
# TENANT_POOL_BUDGET=30
# TENANT_NS_IN_FLIGHT=3
# TRUSTED_PROXY_CIDRS is set by the deploy script to Traefik's exact uy2 address (/32).

# The internal tenant listener binds 10.77.0.10:12013 (prod) and 10.77.0.11:12013
# (next) on the submcp-internal docker network. The deploy script sets these.
