# Copy to .env.prod (gitignored) and fill in real values.
# Used by scripts/start-prod.sh — NEVER commit this file.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=metamcp_db
# SaaS phase 4 (tenant self-serve upstreams). Generate real values with:
#   TENANT_API_SERVICE_TOKEN: openssl rand -hex 32
#   TENANT_SECRET_KEY:        openssl rand -base64 32   (back this up: lost key = lost credentials)
TENANT_API_SERVICE_TOKEN=replace-with-openssl-rand-hex-32
TENANT_SECRET_KEY=replace-with-openssl-rand-base64-32
